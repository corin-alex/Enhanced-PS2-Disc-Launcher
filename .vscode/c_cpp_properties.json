{
  "version": 4,
  "configurations": [
    {
      "name": "PS2 (ee)",
      "includePath": [
        "${workspaceFolder}/src",
        "${env:PS2SDK}/ee/include",
        "${env:PS2SDK}/common/include",
        "${env:PS2SDK}/ports/include"
      ],
      "defines": [
        "_EE",
        "NEWLIB_PORT_AWARE"
      ],
      "compilerPath": "${env:PS2DEV}/ee/bin/mips64r5900el-ps2-elf-gcc",
      "cStandard": "c99",
      "intelliSenseMode": "gcc-x64"
    }
  ]
}
